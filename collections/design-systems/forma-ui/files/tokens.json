{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Forma UI",
    "version": "1.0.0",
    "direction": "Signalétique suisse contemporaine — Institutionnel, documentation et services publics",
    "modes": ["light", "dark"]
  },
  "primitive": {
    "color": {
      "paper-50": "#FAFBF8",
      "paper-100": "#F3F4EF",
      "paper-200": "#E6E8E0",
      "paper-300": "#D2D6CC",
      "ink-950": "#111417",
      "ink-900": "#171A1D",
      "ink-700": "#364049",
      "ink-600": "#4A555E",
      "ink-400": "#8A949C",
      "ink-300": "#B0B5B6",
      "ultramarine-800": "#12287A",
      "ultramarine-700": "#1937A5",
      "ultramarine-600": "#2548C8",
      "ultramarine-100": "#E5EBF9",
      "ultramarine-300": "#84A4FF",
      "ultramarine-200": "#ADC2FF",
      "vermilion-700": "#A82419",
      "vermilion-100": "#FBEAE8",
      "vermilion-300": "#FF8F85",
      "forest-700": "#185C37",
      "forest-100": "#E6F2EB",
      "forest-300": "#75D49E",
      "ochre-700": "#7D4E00",
      "ochre-100": "#F9F0DC",
      "ochre-300": "#F2C46D",
      "slate-950": "#101316",
      "slate-900": "#161B20",
      "slate-850": "#1D242B",
      "slate-700": "#313B45",
      "white": "#FFFFFF"
    },
    "font": {
      "sans": "\"Helvetica Neue\", \"Neue Haas Grotesk Text Pro\", \"Liberation Sans\", Arial, sans-serif",
      "mono": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px",
      "9": "96px"
    },
    "radius": {
      "none": "0px",
      "xs": "2px"
    }
  },
  "semantic": {
    "light": {
      "bg": "{primitive.color.paper-100}",
      "surface": "{primitive.color.paper-50}",
      "surface-subtle": "{primitive.color.paper-200}",
      "fg": "{primitive.color.ink-900}",
      "fg-muted": "{primitive.color.ink-600}",
      "border": "{primitive.color.ink-300}",
      "border-strong": "{primitive.color.ink-900}",
      "accent": "{primitive.color.ultramarine-700}",
      "accent-hover": "{primitive.color.ultramarine-800}",
      "accent-subtle": "{primitive.color.ultramarine-100}",
      "on-accent": "{primitive.color.white}",
      "danger": "{primitive.color.vermilion-700}",
      "danger-subtle": "{primitive.color.vermilion-100}",
      "success": "{primitive.color.forest-700}",
      "success-subtle": "{primitive.color.forest-100}",
      "warning": "{primitive.color.ochre-700}",
      "warning-subtle": "{primitive.color.ochre-100}",
      "focus": "{primitive.color.ultramarine-700}"
    },
    "dark": {
      "bg": "{primitive.color.slate-950}",
      "surface": "{primitive.color.slate-900}",
      "surface-subtle": "{primitive.color.slate-850}",
      "fg": "#EEF0EC",
      "fg-muted": "#A9B2BA",
      "border": "{primitive.color.slate-700}",
      "border-strong": "#EEF0EC",
      "accent": "{primitive.color.ultramarine-300}",
      "accent-hover": "{primitive.color.ultramarine-200}",
      "accent-subtle": "#1A2744",
      "on-accent": "{primitive.color.slate-950}",
      "danger": "{primitive.color.vermilion-300}",
      "danger-subtle": "#361816",
      "success": "{primitive.color.forest-300}",
      "success-subtle": "#132E20",
      "warning": "{primitive.color.ochre-300}",
      "warning-subtle": "#33240B",
      "focus": "{primitive.color.ultramarine-300}"
    }
  },
  "component": {
    "container-max": "1320px",
    "measure-reading": "68ch",
    "control-height": "44px",
    "rule-hairline": "1px",
    "rule-heavy": "2px",
    "action-bg": "{semantic.accent}",
    "action-fg": "{semantic.on-accent}"
  }
}
